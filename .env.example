# =============================================================================
# NEXUS Terminal — variables de entorno
# Modo LOCAL (start.bat / start.ps1): no necesitas ninguna; todo funciona con SQLite en data/nexus.db.
# Modo NUBE (híbrido): backend en Railway/Fly + interfaz en Vercel + base de datos y login en Supabase.
# Guía paso a paso: docs/DEPLOY.md. NUNCA subas un archivo .env con valores reales a GitHub.
# =============================================================================

# ----------------------------------------------------------------------------- BACKEND (Railway / Fly)
# Conexión a Postgres de Supabase: usa la cadena "Session pooler" (IPv4, puerto 5432) de
# Supabase → Project Settings → Database → Connection string.
NEXUS_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Esquema propio (no expuesto por la API pública de Supabase)
NEXUS_DB_SCHEMA=nexus

# Login obligatorio en la nube
NEXUS_AUTH=supabase
NEXUS_SUPABASE_URL=https://<project-ref>.supabase.co
NEXUS_SUPABASE_ANON_KEY=<anon / publishable key>
# Solo estos correos pueden entrar (separados por comas)
NEXUS_ALLOWED_EMAILS=tu-correo@ejemplo.com

# Dominio(s) de la interfaz en Vercel que pueden llamar a la API y abrir el WebSocket
NEXUS_CORS_ORIGINS=https://<tu-app>.vercel.app

# Opcionales
# NEXUS_PG_POOL_MAX=5
# NEXUS_ALLOWED_HOSTS=<tu-backend>.up.railway.app
# NEXUS_BACKGROUND=1

# ----------------------------------------------------------------------------- FRONTEND (Vercel)
# URL pública del backend (sin barra final). La configuración de Supabase se obtiene del backend
# (/api/auth/config), así que solo hace falta esta variable.
VITE_API_BASE=https://<tu-backend>.up.railway.app
