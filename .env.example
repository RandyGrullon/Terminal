# =============================================================================
# NEXUS Terminal — variables de entorno
# Modo LOCAL (start.bat / start.sh): no necesitas ninguna; todo funciona con SQLite en data/nexus.db.
# Modo NUBE (híbrido): backend en Railway/Fly + interfaz en Vercel + base de datos y login en Supabase.
# Guía paso a paso: docs/DEPLOY.md. NUNCA subas un archivo .env con valores reales a GitHub.
# =============================================================================

# ----------------------------------------------------------------------------- BACKEND (Railway / Fly)
# Conexión a Postgres de Supabase: usa la cadena "Session pooler" (IPv4, puerto 5432) de
# Supabase → Project Settings → Database → Connection string (nunca el "Transaction pooler", puerto 6543).
# Obligatoria en la nube: sin ella el servidor no arranca en una IP pública (un SQLite dentro del contenedor
# se perdería en cada despliegue).
NEXUS_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Esquema propio (no expuesto por la API pública de Supabase)
NEXUS_DB_SCHEMA=nexus

# Login obligatorio en la nube
NEXUS_AUTH=supabase
NEXUS_SUPABASE_URL=https://<project-ref>.supabase.co
NEXUS_SUPABASE_ANON_KEY=<anon / publishable key>
# Solo estos correos pueden entrar (separados por comas). Obligatoria: sin ella el servidor no arranca.
NEXUS_ALLOWED_EMAILS=tu-correo@ejemplo.com

# Dominio(s) de la interfaz en Vercel que pueden llamar a la API y abrir el WebSocket
NEXUS_CORS_ORIGINS=https://<tu-app>.vercel.app

# Opcionales
# NEXUS_PG_POOL_MAX=5
# Dominios aceptados en la cabecera Host (separados por comas). /api/health no se restringe, así el chequeo
# de salud de Railway (Host: healthcheck.railway.app) y el de Fly siguen funcionando.
# NEXUS_ALLOWED_HOSTS=<tu-backend>.up.railway.app
# Límite aproximado de memoria por script PyChart, en MB (por defecto 1024; pueden correr 2 a la vez).
# En una máquina de 1 GB usa 320 (fly.toml ya lo fija).
# NEXUS_SCRIPT_MEMORY_MB=320
# Servicios de fondo (vigilancia, escáner, evaluador, cuenta demo). Con Postgres solo una instancia los
# ejecuta aunque haya dos (bloqueo en la base de datos); las demás quedan en espera.
# NEXUS_BACKGROUND=1

# Excepciones explícitas (no recomendadas; el servidor se niega a arrancar sin ellas):
# - aceptar a CUALQUIER usuario de tu proyecto Supabase, sin lista de correos:
# NEXUS_ALLOW_ANY_SUPABASE_USER=1
# - usar SQLite en un servidor público (solo si /app/data es un volumen persistente):
# NEXUS_ALLOW_LOCAL_DB=1

# ----------------------------------------------------------------------------- FRONTEND (Vercel)
# URL pública del backend (sin barra final). La configuración de Supabase se obtiene del backend
# (/api/auth/config), así que solo hace falta esta variable.
VITE_API_BASE=https://<tu-backend>.up.railway.app
